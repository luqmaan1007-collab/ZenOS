[Unit]
Description=ZenOS first-boot account setup
After=systemd-user-sessions.service
Before=display-manager.service
ConditionPathExists=!/var/lib/zenos/firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zenos-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
