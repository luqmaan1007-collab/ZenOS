#!/usr/bin/env bash
set -euo pipefail
DONE=/var/lib/zenos/firstboot.done
[[ -e "$DONE" ]] && exit 0
mkdir -p /var/lib/zenos
echo
echo "Welcome to ZenOS. Create your first local administrator account."
echo "Use a unique password. The password will not be displayed."
while true; do
  read -r -p "Username (lowercase, 3-32 characters): " username
  [[ "$username" =~ ^[a-z_][a-z0-9_-]{2,31}$ ]] || { echo "Invalid username."; continue; }
  ! id "$username" >/dev/null 2>&1 || { echo "That account already exists."; continue; }
  break
done
while true; do
  read -r -s -p "Password (at least 12 characters): " password; echo
  read -r -s -p "Confirm password: " confirm; echo
  [[ ${#password} -ge 12 && "$password" == "$confirm" ]] || { echo "Passwords must match and be at least 12 characters."; continue; }
  break
done
useradd --create-home --groups wheel,audio,video,storage --shell /bin/bash "$username"
printf '%s:%s\n' "$username" "$password" | chpasswd
unset password confirm
install -d -m 0750 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel
touch "$DONE"
echo "Account created. You can now sign in to the ZenOS desktop."
